# Example production reverse proxy for Tornado Mini App.
# Prefer this in front of uvicorn for Brotli + gzip and static offload.
#
# Requires modules: ngx_http_brotli_filter / ngx_http_brotli_static (or omit brotli*).
# Point root to the casinobot project directory (or a deploy package that includes
# dist/, assets/, banners/, soundeffects/).

# IMPORTANT deployment requirements for TORNADO:
#   * Run the app with EXACTLY ONE worker (Crash keeps authoritative round state in
#     memory in a single process; extra workers refuse to accept bets — see H-1).
#         uvicorn main:app --host 127.0.0.1 --port 8080 --workers 1
#     Do NOT put multiple app workers behind this upstream.
#   * TORNADO reads the real client IP as the RIGHT-MOST X-Forwarded-For entry
#     assuming exactly ONE trusted proxy (TRUSTED_PROXY_COUNT=1). This config
#     appends the real peer via $proxy_add_x_forwarded_for and also sets X-Real-IP,
#     so a client-supplied (spoofed) XFF value can never become the apparent IP.
#     If you add another proxy hop (e.g. Cloudflare), bump TRUSTED_PROXY_COUNT.

upstream tornado_app {
    server 127.0.0.1:8080;
    keepalive 32;
}

# Rate-limit zones (must live in the http{} context; shown here for reference).
# Coarse per-IP limits at the edge complement the app's in-process limiter.
limit_req_zone $binary_remote_addr zone=tornado_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=tornado_auth:10m rate=1r/s;

# Redirect all plain HTTP to HTTPS so the Secure session cookie is always usable.
server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com;

    # ssl_certificate     /etc/ssl/certs/example.pem;
    # ssl_certificate_key /etc/ssl/private/example.key;

    # Enforce HTTPS for future visits (HSTS). Do NOT add X-Frame-Options here:
    # Telegram Mini Apps must remain framable inside the Telegram client.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Prefer Brotli; gzip is the fallback for older clients.
    brotli on;
    brotli_comp_level 5;
    brotli_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml
        font/woff
        font/woff2
        application/font-woff
        application/font-woff2;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml
        font/woff
        font/woff2
        application/font-woff
        application/font-woff2;

    # Hashed Vite bundles — long cache, immutable.
    location /app/ {
        alias /var/www/casinobot/dist/app/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Unhashed media — medium cache (filenames change when assets are replaced).
    location /assets/ {
        alias /var/www/casinobot/assets/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location /banners/ {
        alias /var/www/casinobot/banners/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location /soundeffects/ {
        alias /var/www/casinobot/soundeffects/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    # HTML shell must revalidate so new hashed /app/* refs are picked up.
    location = / {
        proxy_pass http://tornado_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # API + Crash WebSocket → uvicorn.
    location /api/ {
        # Coarse flood protection; burst allows normal gameplay bursts.
        limit_req zone=tornado_api burst=40 nodelay;
        proxy_pass http://tornado_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Tighter limit specifically for the authentication surface.
    location = /api/auth {
        limit_req zone=tornado_auth burst=10 nodelay;
        proxy_pass http://tornado_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /crash/ {
        proxy_pass http://tornado_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://tornado_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
